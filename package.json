{
  "name": "liferl",
  "version": "1.0.0",
  "private": false,
  "description": "A markdown-backed vibe habit tracker to fix your life.",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:web": "next dev --webpack -H 0.0.0.0 -p 5173",
    "dev:api": "python3 -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 5174",
    "start": "bun run scripts/start.mjs",
    "start:web": "next start -H 0.0.0.0 -p 5173",
    "start:api": "python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 5174",
    "service": "bun run cli.ts",
    "service:setup": "bun run cli.ts setup",
    "service:run": "bun run cli.ts run",
    "service:start": "bun run cli.ts start",
    "service:stop": "bun run cli.ts stop",
    "service:restart": "bun run cli.ts restart",
    "service:status": "bun run cli.ts status",
    "service:logs": "bun run cli.ts logs",
    "service:systemd:print": "bun run cli.ts systemd:print",
    "service:systemd:install": "bun run cli.ts systemd:install",
    "service:systemd:uninstall": "bun run cli.ts systemd:uninstall",
    "screenshots": "bun run scripts/capture-screenshots.ts",
    "build": "next build --webpack",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "habit-tracker",
    "markdown",
    "obsidian",
    "life-rpg",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joey00072/liferl.git"
  },
  "bugs": {
    "url": "https://github.com/joey00072/liferl/issues"
  },
  "homepage": "https://github.com/joey00072/liferl#readme",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0"
  }
}
